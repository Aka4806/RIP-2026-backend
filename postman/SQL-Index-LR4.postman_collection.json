{
  "info": {
    "name": "SQL Index API — ЛР4 JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Регистрация, вход, JWT, конфигурации, выход и Redis blacklist."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:18084"
    },
    {
      "key": "index_id",
      "value": ""
    },
    {
      "key": "feed_id",
      "value": ""
    },
    {
      "key": "next",
      "value": "false"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "username",
      "value": "student"
    },
    {
      "key": "password",
      "value": "demo-password"
    }
  ],
  "item": [
    {
      "name": "01 Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Вход и сохранение JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/authentication",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Список с фильтром",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/indexes?table_size=1000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Создать черновик с файлами",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/indexes",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "B-tree 1M API",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "media/btree_100k.png"
            },
            {
              "key": "video",
              "type": "file",
              "src": "media/btree_100k.mp4"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"index_id\", String(pm.response.json().id)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Получить черновик",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/indexes/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Опубликовать карточку",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/indexes/{{index_id}}/publication",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"short_description\": \"B-tree хранит ключи в отсортированном виде. Поддерживает точный поиск, диапазоны и сортировку.\",\n  \"table_size\": 1000000,\n  \"selectivity\": 0.01\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Лента без ID или следующая по ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/feed/{{feed_id}}?next={{next}}",
        "description": "Сначала feed_id пустой, next=false. Затем задайте feed_id равным index_id и next=true и выполните этот же запрос повторно."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Поставить или отменить лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/indexes/{{index_id}}/likes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"like\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Удалить свою карточку",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/indexes/{{index_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Деавторизация",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/users/authorization"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", \"\");"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}